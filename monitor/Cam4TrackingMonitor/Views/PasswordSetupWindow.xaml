<Window x:Class="Cam4TrackingMonitor.Views.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar senha de manutenção" Width="460" Height="330"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBackground}" Foreground="{StaticResource TextPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Configurar senha de manutenção" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,12,0,5" Text="Nova senha:"/>
        <PasswordBox x:Name="NewPasswordInput" Grid.Row="2" MinWidth="360"/>
        <TextBlock Grid.Row="3" Margin="0,10,0,5" Text="Confirmar senha:"/>
        <PasswordBox x:Name="ConfirmPasswordInput" Grid.Row="4" MinWidth="360" KeyDown="ConfirmPasswordInput_KeyDown"/>
        <TextBlock x:Name="ErrorText" Grid.Row="5" Margin="0,8,0,0" Foreground="{StaticResource StatusError}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Criar senha" MinWidth="105" Click="Create_Click"/>
            <Button Content="Cancelar" MinWidth="95" Margin="8,0,0,0" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
