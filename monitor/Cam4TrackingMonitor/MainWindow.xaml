<Window x:Class="Cam4TrackingMonitor.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:conv="clr-namespace:Cam4TrackingMonitor.Converters" xmlns:views="clr-namespace:Cam4TrackingMonitor.Views" Title="Broadcast Camera Tracking Monitor" Icon="Assets/cam4.ico" Height="900" Width="1440" MinHeight="720" MinWidth="1100" WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBackground}" Foreground="{StaticResource TextPrimary}">
 <Window.Resources>
  <conv:NullToNaConverter x:Key="Na"/><conv:ValuesDifferConverter x:Key="Differ"/><BooleanToVisibilityConverter x:Key="BoolVisibility"/><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Margin" Value="8"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,18,0,8"/></Style>
  <Style x:Key="StatusText" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Style.Triggers><Trigger Property="Text" Value="OK"><Setter Property="Foreground" Value="{StaticResource StatusOk}"/></Trigger><Trigger Property="Text" Value="ONLINE"><Setter Property="Foreground" Value="{StaticResource StatusOk}"/></Trigger><Trigger Property="Text" Value="CONNECTED"><Setter Property="Foreground" Value="{StaticResource StatusOk}"/></Trigger><Trigger Property="Text" Value="WAITING"><Setter Property="Foreground" Value="{StaticResource StatusWaiting}"/></Trigger><Trigger Property="Text" Value="INACTIVE"><Setter Property="Foreground" Value="{StaticResource StatusWaiting}"/></Trigger><Trigger Property="Text" Value="WARNING"><Setter Property="Foreground" Value="{StaticResource StatusWarning}"/></Trigger><Trigger Property="Text" Value="ERROR"><Setter Property="Foreground" Value="{StaticResource StatusError}"/></Trigger><Trigger Property="Text" Value="OFFLINE"><Setter Property="Foreground" Value="{StaticResource StatusError}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="ChangedIndicator" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource StatusWarning}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
  <Style x:Key="ChangedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><Trigger Property="Tag" Value="True"><Setter Property="BorderBrush" Value="{StaticResource StatusWarning}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="ToolTip" Value="ALTERADO — ainda não aplicado"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid Margin="22" Background="{StaticResource SurfaceBackground}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="4,0,4,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="58" Height="58" Margin="0,0,14,0" CornerRadius="10" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"><Image Source="Assets/cam4-mark.png" Width="48" Height="48" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="BROADCAST CAMERA TRACKING MONITOR – PROTECTED" FontSize="27" FontWeight="Bold"/><TextBlock Text="Engineering console • Tracking Box telemetry and configuration" Foreground="{StaticResource MutedBrush}"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding ConnectionStatus, Mode=OneWay}" Style="{StaticResource StatusText}" FontSize="18" HorizontalAlignment="Right"/><TextBlock Text="{Binding BoxIp, StringFormat=Tracking Box: {0}, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Dashboard.LastUpdate, StringFormat=Última atualização: {0}, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Configuration.MaintenanceStatus, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></Grid></Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0">
   <TabItem Header="DASHBOARD"><views:DashboardView DataContext="{Binding Dashboard, Mode=OneWay}"/></TabItem>
   <TabItem Header="CONFIGURAÇÃO"><Grid Margin="8,14,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Button Content="Ler da Tracking Box" Command="{Binding Configuration.ReadCommand, Mode=OneWay}"/><Button Content="Aplicar" Command="{Binding Configuration.ApplyCommand, Mode=OneWay}"/><Button Content="Salvar" Command="{Binding Configuration.SaveCommand, Mode=OneWay}"/><Button Content="Reiniciar" Command="{Binding Configuration.RebootCommand, Mode=OneWay}"/><Button Content="Restaurar padrão" Command="{Binding Configuration.DefaultCommand, Mode=OneWay}" Background="{StaticResource StatusWarning}"/><Button Content="Alterar senha de manutenção" Command="{Binding Configuration.ChangePasswordCommand, Mode=OneWay}" Margin="24,0,0,0" Padding="10,5" FontSize="12"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="NETWORK" Style="{StaticResource Section}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="230"/><ColumnDefinition Width="35"/><ColumnDefinition Width="230"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <TextBlock Text="Parâmetro" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="1" Text="ATUAL" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="3" Text="NOVO" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock Grid.Row="1" Text="IP"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Configuration.CurrentConfiguration.Ip, TargetNullValue=N/A, Mode=OneWay}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="→"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Configuration.EditedConfiguration.Ip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChangedTextBox}"><TextBox.Tag><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.Ip" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.Ip" Mode="OneWay"/></MultiBinding></TextBox.Tag></TextBox><TextBlock Text="ALTERADO" Style="{StaticResource ChangedIndicator}" Grid.Row="1" Grid.Column="4"><TextBlock.Visibility><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.Ip" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.Ip" Mode="OneWay"/></MultiBinding></TextBlock.Visibility></TextBlock>
      <TextBlock Grid.Row="2" Text="Máscara"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Configuration.CurrentConfiguration.SubnetMask, TargetNullValue=N/A, Mode=OneWay}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="→"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Configuration.EditedConfiguration.SubnetMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChangedTextBox}"><TextBox.Tag><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.SubnetMask" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.SubnetMask" Mode="OneWay"/></MultiBinding></TextBox.Tag></TextBox><TextBlock Text="ALTERADO" Style="{StaticResource ChangedIndicator}" Grid.Row="2" Grid.Column="4"><TextBlock.Visibility><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.SubnetMask" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.SubnetMask" Mode="OneWay"/></MultiBinding></TextBlock.Visibility></TextBlock>
      <TextBlock Grid.Row="3" Text="Gateway"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Configuration.CurrentConfiguration.Gateway, TargetNullValue=N/A, Mode=OneWay}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="→"/><TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Configuration.EditedConfiguration.Gateway, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChangedTextBox}"><TextBox.Tag><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.Gateway" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.Gateway" Mode="OneWay"/></MultiBinding></TextBox.Tag></TextBox><TextBlock Text="ALTERADO" Style="{StaticResource ChangedIndicator}" Grid.Row="3" Grid.Column="4"><TextBlock.Visibility><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.Gateway" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.Gateway" Mode="OneWay"/></MultiBinding></TextBlock.Visibility></TextBlock>
      <TextBlock Grid.Row="4" Text="DNS"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Configuration.CurrentConfiguration.Dns, TargetNullValue=N/A, Mode=OneWay}"/><TextBlock Grid.Row="4" Grid.Column="2" Text="→"/><TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Configuration.EditedConfiguration.Dns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChangedTextBox}"><TextBox.Tag><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.Dns" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.Dns" Mode="OneWay"/></MultiBinding></TextBox.Tag></TextBox><TextBlock Text="ALTERADO" Style="{StaticResource ChangedIndicator}" Grid.Row="4" Grid.Column="4"><TextBlock.Visibility><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.Dns" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.Dns" Mode="OneWay"/></MultiBinding></TextBlock.Visibility></TextBlock>
     </Grid><CheckBox IsChecked="{Binding Configuration.EditedConfiguration.DhcpFlag, Mode=TwoWay}" Content="Flag DHCP (cliente DHCP não está funcional no firmware atual)" Foreground="{StaticResource StatusWarning}"/>
     <TextBlock Text="FREE-D" Style="{StaticResource Section}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Número de destinos (0–7)" Width="210"/><TextBlock Text="{Binding Configuration.CurrentConfiguration.DestinationCount, TargetNullValue=N/A, Mode=OneWay}" Width="70"/><TextBlock Text="→"/><TextBox Width="90" Text="{Binding Configuration.EditedConfiguration.DestinationCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChangedTextBox}"><TextBox.Tag><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.DestinationCount" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.DestinationCount" Mode="OneWay"/></MultiBinding></TextBox.Tag></TextBox><TextBlock Text="ALTERADO" Style="{StaticResource ChangedIndicator}" ><TextBlock.Visibility><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.DestinationCount" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.DestinationCount" Mode="OneWay"/></MultiBinding></TextBlock.Visibility></TextBlock></StackPanel>
     <DataGrid ItemsSource="{Binding Configuration.Destinations, Mode=OneWay}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number, Mode=OneWay}" IsReadOnly="True"/><DataGridTextColumn Header="IP atual" Binding="{Binding CurrentIp, Mode=OneWay}" IsReadOnly="True" Width="160"/><DataGridTextColumn Header="Novo IP" Binding="{Binding NewIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180"/><DataGridTextColumn Header="Porta atual" Binding="{Binding CurrentPort, Mode=OneWay}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Nova porta" Binding="{Binding NewPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="Estado" Binding="{Binding ChangeStatus, Mode=OneWay}" IsReadOnly="True" Width="110"><DataGridTextColumn.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Style.Triggers><DataTrigger Binding="{Binding IsChanged, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{StaticResource StatusWarning}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></DataGridTextColumn.CellStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
     <TextBlock Text="TRACKING" Style="{StaticResource Section}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Ordem dos eixos" Width="170"/><TextBlock Text="{Binding Configuration.CurrentConfiguration.AxisOrder, TargetNullValue=N/A, Mode=OneWay}" Width="80"/><TextBlock Text="→"/><TextBox Width="120" Text="{Binding Configuration.EditedConfiguration.AxisOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChangedTextBox}"><TextBox.Tag><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.AxisOrder" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.AxisOrder" Mode="OneWay"/></MultiBinding></TextBox.Tag></TextBox><TextBlock Text="ALTERADO" Style="{StaticResource ChangedIndicator}" ><TextBlock.Visibility><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.AxisOrder" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.AxisOrder" Mode="OneWay"/></MultiBinding></TextBlock.Visibility></TextBlock></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Ordem dos ângulos" Width="170"/><TextBlock Text="{Binding Configuration.CurrentConfiguration.AngleOrder, TargetNullValue=N/A, Mode=OneWay}" Width="80"/><TextBlock Text="→"/><TextBox Width="120" Text="{Binding Configuration.EditedConfiguration.AngleOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ChangedTextBox}"><TextBox.Tag><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.AngleOrder" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.AngleOrder" Mode="OneWay"/></MultiBinding></TextBox.Tag></TextBox><TextBlock Text="ALTERADO" Style="{StaticResource ChangedIndicator}" ><TextBlock.Visibility><MultiBinding Converter="{StaticResource Differ}"><Binding Path="Configuration.CurrentConfiguration.AngleOrder" Mode="OneWay"/><Binding Path="Configuration.EditedConfiguration.AngleOrder" Mode="OneWay"/></MultiBinding></TextBlock.Visibility></TextBlock></StackPanel>
     <TextBlock Text="Inversões" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,2"/><WrapPanel><CheckBox Content="X" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.X, Mode=TwoWay}"/><CheckBox Content="Y" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.Y, Mode=TwoWay}"/><CheckBox Content="Z" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.Z, Mode=TwoWay}"/><CheckBox Content="Pan" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.Pan, Mode=TwoWay}"/><CheckBox Content="Tilt" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.Tilt, Mode=TwoWay}"/><CheckBox Content="Roll" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.Roll, Mode=TwoWay}"/><CheckBox Content="Foco" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.Focus, Mode=TwoWay}"/><CheckBox Content="Zoom" IsChecked="{Binding Configuration.EditedConfiguration.Inversions.Zoom, Mode=TwoWay}"/></WrapPanel>
     <TextBlock Text="Offsets" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,2"/><WrapPanel><TextBlock Text="X"/><TextBox Width="85" Text="{Binding Configuration.EditedConfiguration.Offsets.X, Mode=TwoWay}"/><TextBlock Text="Y"/><TextBox Width="85" Text="{Binding Configuration.EditedConfiguration.Offsets.Y, Mode=TwoWay}"/><TextBlock Text="Z"/><TextBox Width="85" Text="{Binding Configuration.EditedConfiguration.Offsets.Z, Mode=TwoWay}"/><TextBlock Text="Pan"/><TextBox Width="85" Text="{Binding Configuration.EditedConfiguration.Offsets.Pan, Mode=TwoWay}"/><TextBlock Text="Tilt"/><TextBox Width="85" Text="{Binding Configuration.EditedConfiguration.Offsets.Tilt, Mode=TwoWay}"/><TextBlock Text="Roll"/><TextBox Width="85" Text="{Binding Configuration.EditedConfiguration.Offsets.Roll, Mode=TwoWay}"/></WrapPanel>
     <TextBlock Text="SISTEMA" Style="{StaticResource Section}"/><TextBlock><Run Text="Versão do preset: "/><Run Text="{Binding Configuration.CurrentConfiguration.PresetVersion, Converter={StaticResource Na}, Mode=OneWay}"/><Run Text="   •   Versão do firmware: não disponibilizada"/></TextBlock><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Timeout TCP (s)" Width="170"/><TextBox Width="90" Text="{Binding TcpTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/></StackPanel>
    </StackPanel></ScrollViewer><Border Grid.Row="2" Background="{StaticResource SurfaceRaised}" Padding="12" Margin="0,10,0,0"><TextBlock Text="{Binding Configuration.Status, Mode=OneWay}" TextWrapping="Wrap"/></Border>
   </Grid></TabItem>
   <TabItem Header="EVENTOS / DIAGNÓSTICO">
    <TabItem.Resources>
     <Style x:Key="TelemetryCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ChartGrid}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
     <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="14"/></Style>
     <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Margin" Value="0,2"/></Style>
     <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </TabItem.Resources>
    <Grid Margin="8,14,8,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><Button Content="Exportar Log" Command="{Binding Events.ExportLogCommand, Mode=OneWay}"/><Button Content="Abrir Pasta de Logs" Command="{Binding Events.OpenLogsCommand, Mode=OneWay}"/></StackPanel>
     <Border Grid.Row="1" Style="{StaticResource TelemetryCard}" Margin="0,10,0,0" Padding="12,8">
      <StackPanel>
       <TextBlock Text="APP ↔ BOX · DIAGNÓSTICO DA SESSÃO" Style="{StaticResource CardTitle}" Margin="0,0,0,7"/>
       <UniformGrid Columns="7">
        <StackPanel><TextBlock Text="TOTAL POLLS" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TotalPolls}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="VALID" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.ValidPolls}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="FAILURES" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.FailedPolls}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="CONNECT FAIL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.ConnectFailures}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="WRITE FAIL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.WriteFailures}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="READ FAIL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.ReadFailures}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="PARSE FAIL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.ParseFailures}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="VALIDATION FAIL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.ValidationFailures}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="CONNECTION RESET" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.ConnectionResets}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="TIMEOUT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.Timeouts}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="OTHER" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.OtherFailures}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="AVG RESPONSE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.AverageResponse}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="MAX RESPONSE" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.MaximumResponse}" Style="{StaticResource MetricValue}"/></StackPanel>
       </UniformGrid>
      </StackPanel>
     </Border>
     <Border Grid.Row="2" Style="{StaticResource TelemetryCard}" Margin="0,10,0,0" Padding="12,8">
      <StackPanel>
       <TextBlock Text="TRACKING BOX · TCP SERVER" Style="{StaticResource CardTitle}" Margin="0,0,0,7"/>
       <UniformGrid Columns="8">
        <StackPanel><TextBlock Text="ACCEPT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpAccept}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="RX OK / ERR" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpRx}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="SEND CALL" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpSendCall}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="SEND RET OK / ERR" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpSendRet}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="SEND OK" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpSendOk}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="TIMEOUT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpTimeout}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="CLOSE WAIT" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpCloseWait}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="DISCON / REOPEN" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpDisconReopen}" Style="{StaticResource MetricValue}"/></StackPanel>
       </UniformGrid>
       <UniformGrid Columns="5" Margin="0,7,0,0">
        <StackPanel><TextBlock Text="LAST SR" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpLastSr}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="LAST IR" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpLastIr}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="LAST RECV" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpLastRecv}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="LAST SEND" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpLastSend}" Style="{StaticResource MetricValue}"/></StackPanel>
        <StackPanel><TextBlock Text="LAST TX FSR" Style="{StaticResource MetricLabel}"/><TextBlock Text="{Binding Events.TcpLastTxFsr}" Style="{StaticResource MetricValue}"/></StackPanel>
       </UniformGrid>
      </StackPanel>
     </Border>
     <ListView Grid.Row="3" ItemsSource="{Binding Events.Events, Mode=OneWay}" Background="{StaticResource SurfaceRaised}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="0,10,0,0"><ListView.View><GridView><GridViewColumn Header="Timestamp" Width="175" DisplayMemberBinding="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm:ss, Mode=OneWay}"/><GridViewColumn Header="Severidade" Width="90" DisplayMemberBinding="{Binding Severity, Mode=OneWay}"/><GridViewColumn Header="Categoria" Width="110" DisplayMemberBinding="{Binding Category, Mode=OneWay}"/><GridViewColumn Header="Evento" Width="190" DisplayMemberBinding="{Binding Event, Mode=OneWay}"/><GridViewColumn Header="Anterior" Width="145" DisplayMemberBinding="{Binding PreviousValue, Mode=OneWay}"/><GridViewColumn Header="Novo" Width="145" DisplayMemberBinding="{Binding NewValue, Mode=OneWay}"/><GridViewColumn Header="Resultado" Width="110" DisplayMemberBinding="{Binding Result, Mode=OneWay}"/><GridViewColumn Header="Mensagem" Width="390" DisplayMemberBinding="{Binding Message, Mode=OneWay}"/></GridView></ListView.View></ListView>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</Window>
