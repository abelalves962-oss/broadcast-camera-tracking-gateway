<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SurfaceBackgroundColor">#0A1118</Color>
    <Color x:Key="SurfaceRaisedColor">#111C27</Color>
    <Color x:Key="CardBackgroundColor">#172431</Color>
    <Color x:Key="InputBackgroundColor">#0D1721</Color>
    <Color x:Key="TextPrimaryColor">#F4F8FB</Color>
    <Color x:Key="TextSecondaryColor">#B8C6D2</Color>
    <Color x:Key="AccentColor">#35C2DC</Color>
    <Color x:Key="BorderColorValue">#496175</Color>
    <Color x:Key="StatusOkColor">#48D597</Color>
    <Color x:Key="StatusWarningColor">#FFC15A</Color>
    <Color x:Key="StatusErrorColor">#FF6673</Color>
    <Color x:Key="StatusWaitingColor">#82B8DC</Color>
    <Color x:Key="SelectionColor">#244C63</Color>
    <Color x:Key="ChartBackgroundColor">#0D161F</Color>
    <Color x:Key="ChartGridColor">#263746</Color>
    <Color x:Key="ChartAmberColor">#F59E42</Color>
    <Color x:Key="ChartCyanColor">#35C2DC</Color>
    <Color x:Key="ChartWarningColor">#F2C94C</Color>
    <Color x:Key="ChartErrorColor">#FF5C5C</Color>

    <SolidColorBrush x:Key="SurfaceBackground" Color="{StaticResource SurfaceBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BorderColor" Color="{StaticResource BorderColorValue}"/>
    <SolidColorBrush x:Key="StatusOk" Color="{StaticResource StatusOkColor}"/>
    <SolidColorBrush x:Key="StatusWarning" Color="{StaticResource StatusWarningColor}"/>
    <SolidColorBrush x:Key="StatusError" Color="{StaticResource StatusErrorColor}"/>
    <SolidColorBrush x:Key="StatusWaiting" Color="{StaticResource StatusWaitingColor}"/>
    <SolidColorBrush x:Key="Selection" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="ChartBackground" Color="{StaticResource ChartBackgroundColor}"/>
    <SolidColorBrush x:Key="ChartGrid" Color="{StaticResource ChartGridColor}"/>
    <SolidColorBrush x:Key="ChartAmber" Color="{StaticResource ChartAmberColor}"/>
    <SolidColorBrush x:Key="ChartCyan" Color="{StaticResource ChartCyanColor}"/>
    <SolidColorBrush x:Key="ChartWarning" Color="{StaticResource ChartWarningColor}"/>
    <SolidColorBrush x:Key="ChartError" Color="{StaticResource ChartErrorColor}"/>
</ResourceDictionary>
